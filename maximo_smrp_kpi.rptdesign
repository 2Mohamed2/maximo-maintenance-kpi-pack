                <cell id="105"><property name="paddingBottom">6pt</property>
                    <label id="106"><property name="fontSize">7.5pt</property><property name="color">#525252</property><property name="fontWeight">bold</property><property name="letterSpacing">0.32pt</property><text-property name="text">IBM MAXIMO  ·  MAINTENANCE KPI PACK  ·  SMRP BEST PRACTICES METRICS</text-property></label>
                    <label id="107"><property name="fontSize">20pt</property><property name="color">#161616</property><property name="marginTop">2pt</property><text-property name="text">How well is maintenance performing?</text-property></label>
                    <label id="108"><property name="fontSize">9pt</property><property name="color">#525252</property><property name="marginTop">2pt</property><text-property name="text">The maintenance and reliability KPIs of the Society for Maintenance &amp; Reliability Professionals (SMRP), measured from this Maximo's work orders, assets, labour and stores, across the five SMRP pillars. Read-only, on SQL Server, Oracle or Db2.</text-property></label>
                    <label id="109"><property name="fontSize">8pt</property><property name="color">#0043ce</property><property name="fontWeight">bold</property><property name="marginTop">4pt</property><text-property name="text">Created by Mohamed Chihaoui</text-property></label>
                </cell>
                <cell id="110"><property name="textAlign">right</property><property name="verticalAlign">bottom</property><property name="paddingBottom">6pt</property>
