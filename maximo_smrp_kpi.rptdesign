<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">Eclipse BIRT Designer Version 4.3.1.v201309091055 Build &lt;4.3.1.v20130918-1142></property>
    <property name="author">Mohamed Chihaoui</property>
    <html-property name="description">Maintenance KPI pack based on the SMRP Best Practices metrics, for SQL Server, Oracle and Db2 (read-only). Created by Mohamed Chihaoui.</html-property>
    <property name="units">in</property>
    <method name="initialize"><![CDATA[importPackage(Packages.com.ibm.tivoli.maximo.report.script);
mxReportScriptContext = MXReportScriptContext.initialize(reportContext);
scriptLogger = mxReportScriptContext.getReportScriptLogger();
// Maximo maintenance KPI pack (SMRP Best Practices metrics): read-only SQL for Microsoft SQL Server, Oracle and IBM Db2.
//
//   smrpPeriodSql(db, site)  -> SQL: work orders reported per month (picks the period when no end month is given)
//   smrpSql(db, p)           -> { key: sql }
//     db : "sqlserver" | "oracle" | "db2"
//     p  : { site, start, end, e365, prev, pdm, corr, emer }
//          start / end : "YYYY-MM-DD" (end is exclusive), e365 : end minus 12 months (inactive stock cut-off)
//          prev / pdm / corr / emer : comma-separated work types for preventive, predictive or condition-based,
//                                     corrective and emergency work
//
// This source file is built into the report (build.py); the .rptdesign is the only file Maximo needs.
// Every key returns the same column names on every database. Every statement is a SELECT on Maximo tables:
// nothing is created or changed, and the Maximo database login is enough.
// Created by Mohamed Chihaoui.
function smrpCodes(csv, dflt) {
  var out = [], raw = String(csv == null || csv === "" ? dflt : csv).split(",");
  for (var i = 0; i < raw.length; i++) {
    var v = raw[i].replace(/^\s+|\s+$/g, "").toUpperCase();
    if (v.length > 0 && /^[A-Z0-9_\-]+$/.test(v)) out.push("'" + v + "'");
  }
  return out.length ? out.join(",") : "'~'";
}

function smrpSite(site) {
  var s = String(site == null ? "" : site).replace(/^\s+|\s+$/g, "").toUpperCase();
  return /^[A-Z0-9_\-]+$/.test(s) ? s : "";
}

function smrpPeriodSql(db, site) {
  var ORA = db == "oracle", s = smrpSite(site);
  var y = ORA ? "extract(year from w.reportdate)" : "year(w.reportdate)";
  var m = ORA ? "extract(month from w.reportdate)" : "month(w.reportdate)";
  return "select /* mxsmrp */ " + y + " yr, " + m + " mo, count(*) n, v.upg upg from workorder w " +
         "cross join (select max(varvalue) upg from maxvars where varname = 'MAXUPG') v " +
         "where w.woclass = 'WORKORDER' and w.istask = 0 and w.reportdate is not null" +
         (s ? " and w.siteid = '" + s + "'" : "") + " group by " + y + ", " + m + ", v.upg";
}

function smrpSql(db, p) {
  db = db || "sqlserver";
  var SS = db == "sqlserver", ORA = db == "oracle", DB2 = db == "db2";
  var DUAL = ORA ? " from dual" : DB2 ? " from sysibm.sysdummy1" : "";
  var site = smrpSite(p.site);

  // ---- dialect helpers
  function d(s) {   // date literal
    if (SS) return "cast('" + s + "' as datetime)";
    if (ORA) return "to_date('" + s + "', 'YYYY-MM-DD')";
    return "timestamp('" + s + " 00:00:00')";
  }
  function hrs(a, b) {   // hours from a to b
    if (SS) return "(datediff(minute, " + a + ", " + b + ") / 60.0)";
    if (ORA) return "((" + b + " - " + a + ") * 24)";
    return "(((days(" + b + ") - days(" + a + ")) * 86400 + (midnight_seconds(" + b + ") - midnight_seconds(" + a + "))) / 3600.0)";
  }
  function dys(a, b) { return "(" + hrs(a, b) + " / 24.0)"; }
  function plus1(x) { return SS ? "dateadd(day, 1, " + x + ")" : ORA ? "(" + x + " + 1)" : "(" + x + " + 1 day)"; }
  function ym(x) { return SS ? "convert(char(7), " + x + ", 120)" : ORA ? "to_char(" + x + ", 'YYYY-MM')" : "varchar_format(" + x + ", 'YYYY-MM')"; }
  function limit(sql, n) {
    if (SS) return "select top " + n + " " + sql.substring(7);
    if (ORA) return "select * from (" + sql + ") where rownum <= " + n;
    return sql + " fetch first " + n + " rows only";
  }
  function mark(sql) { return sql.replace(/^select /, "select /* mxsmrp */ "); }
  function siteF(a) { return site ? " and " + a + ".siteid = '" + site + "'" : ""; }
  function nz(x) { return "coalesce(" + x + ", 0)"; }

  var S = d(p.start), E = d(p.end), E365 = d(p.e365);
  var PREV = smrpCodes(p.prev, "PM,PMCAL,CAL"), PDM = smrpCodes(p.pdm, "PDM,CBM"),
      CORR = smrpCodes(p.corr, "CM,CMCAL"), EMER = smrpCodes(p.emer, "EM,EMCAL");

  // work category of a work order: D predictive/condition-based, P preventive (or generated by a PM), E emergency,
  // C corrective, O other (capital, projects, events ...)
  function cat(w) {
    return "(case when upper(" + w + ".worktype) in (" + PDM + ") then 'D' " +
           "when " + w + ".pmnum is not null or upper(" + w + ".worktype) in (" + PREV + ") then 'P' " +
           "when upper(" + w + ".worktype) in (" + EMER + ") then 'E' " +
           "when upper(" + w + ".worktype) in (" + CORR + ") then 'C' else 'O' end)";
  }
  function isPrev(w) { return "(upper(" + w + ".worktype) in (" + PDM + ") or " + w + ".pmnum is not null or upper(" + w + ".worktype) in (" + PREV + "))"; }
  function isFail(w) { return "(upper(" + w + ".worktype) in (" + CORR + "," + EMER + ") and not " + isPrev(w) + ")"; }
  function cost(w) { return "(" + nz(w + ".actlabcost") + " + " + nz(w + ".actmatcost") + " + " + nz(w + ".actservcost") + " + " + nz(w + ".acttoolcost") + ")"; }
  function estCost(w) { return "(" + nz(w + ".estlabcost") + " + " + nz(w + ".estmatcost") + " + " + nz(w + ".estservcost") + " + " + nz(w + ".esttoolcost") + ")"; }
  function due(w) { return "coalesce(" + w + ".pmduedate, " + w + ".targcompdate, " + w + ".schedfinish)"; }
  // work order status through its synonym (customers rename statuses): join synonymdomain as st
  function wo(w, st) {
    return "workorder " + w + " join synonymdomain " + st + " on " + st + ".domainid = 'WOSTATUS' and " + st + ".value = " + w + ".status";
  }
  function done(w, st) { return "(" + st + ".maxvalue in ('COMP','CLOSE') and " + w + ".actfinish >= " + S + " and " + w + ".actfinish < " + E + ")"; }
  var OPEN = "not in ('COMP','CLOSE','CAN','HISTEDIT')";
  var BACKLOG = "in ('APPR','WSCH','WMATL','INPRG')", READY = "in ('APPR','WSCH')";
  var BASE = "w.woclass = 'WORKORDER'" + siteF("w");
  function sumIf(cond, expr) { return "sum(case when " + cond + " then " + expr + " else 0 end)"; }
  function cntIf(cond) { return sumIf(cond, "1"); }
  var PLANNED = "(w.estlabhrs > 0 or w.jpnum is not null)";
  var REPAIR = "(w.actstart is not null and w.actfinish > w.actstart and " + hrs("w.actstart", "w.actfinish") + " <= 720)";

  var o = {};

  // ---- one row: every number the scorecard needs
  var A = "select " + sumIf("sa.maxvalue = 'OPERATING'", nz("a.replacecost")) + " rav, " +
          cntIf("sa.maxvalue = 'OPERATING'") + " nassets, " +
          cntIf("sa.maxvalue = 'OPERATING' and a.priority is not null") + " ncrit " +
          "from asset a join synonymdomain sa on sa.domainid = 'LOCASSETSTATUS' and sa.value = a.status where 1 = 1" + siteF("a");
  var L = "select count(*) labor_n from labor l join synonymdomain sl on sl.domainid = 'LABORSTATUS' and sl.value = l.status " +
          "where sl.maxvalue = 'ACTIVE'";
  var C = cat("w");
  var D = "select " + cntIf("w.istask = 0") + " wo_done, " +
          "sum(" + nz("w.actlabhrs") + ") hrs_total, sum(" + cost("w") + ") cost_total, " +
          "sum(" + nz("w.actlabcost") + ") cost_lab, sum(" + nz("w.actmatcost") + ") cost_mat, " +
          "sum(" + nz("w.actservcost") + ") cost_serv, sum(" + nz("w.acttoolcost") + ") cost_tool, " +
          sumIf(C + " = 'P'", nz("w.actlabhrs")) + " hrs_p, " + sumIf(C + " = 'D'", nz("w.actlabhrs")) + " hrs_d, " +
          sumIf(C + " = 'C'", nz("w.actlabhrs")) + " hrs_c, " + sumIf(C + " = 'E'", nz("w.actlabhrs")) + " hrs_e, " +
          sumIf(C + " = 'O'", nz("w.actlabhrs")) + " hrs_o, " +
          sumIf(C + " = 'P'", cost("w")) + " cost_p, " + sumIf(C + " = 'D'", cost("w")) + " cost_d, " +
          sumIf(C + " = 'C'", cost("w")) + " cost_c, " + sumIf(C + " = 'E'", cost("w")) + " cost_e, " +
          sumIf(C + " = 'O'", cost("w")) + " cost_o, " +
          sumIf(PLANNED, nz("w.actlabhrs")) + " hrs_planned, " +
          sumIf("w.estlabhrs > 0", nz("w.actlabhrs")) + " act_hrs_est, " + sumIf("w.estlabhrs > 0", "w.estlabhrs") + " est_hrs, " +
          sumIf(estCost("w") + " > 0", cost("w")) + " act_cost_est, " + sumIf(estCost("w") + " > 0", estCost("w")) + " est_cost, " +
          "sum(" + nz("w.actoutlabcost") + " + " + nz("w.actservcost") + ") cost_out, " +
          "sum(" + nz("w.actintlabhrs") + ") hrs_int, sum(" + nz("w.actoutlabhrs") + ") hrs_out, " +
          sumIf("w.istask = 0 and w.reportdate is not null and w.reportdate <= w.actfinish", dys("w.reportdate", "w.actfinish")) + " cycle_days, " +
          cntIf("w.istask = 0 and w.reportdate is not null and w.reportdate <= w.actfinish") + " cycle_n " +
          "from " + wo("w", "st") + " where " + BASE + " and " + done("w", "st");
  var PM = "select count(*) pm_due, " +
           cntIf("st.maxvalue in ('COMP','CLOSE') and w.actfinish < " + plus1(due("w"))) + " pm_ok " +
           "from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and st.maxvalue <> 'CAN' and " + isPrev("w") +
           " and " + due("w") + " >= " + S + " and " + due("w") + " < " + E;
  var PMO = "select count(*) pm_overdue, sum(" + nz("w.estlabhrs") + ") pm_overdue_hrs from " + wo("w", "st") + " where " + BASE +
            " and w.istask = 0 and st.maxvalue " + OPEN + " and st.maxvalue <> 'WAPPR' and " + isPrev("w") + " and " + due("w") + " < " + E +
            " and w.reportdate < " + E;
  // follow-up work found by preventive work orders (counted in their own select: SQL Server allows no subquery in an aggregate)
  var PMW = "from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and " + isPrev("w") + " and " + done("w", "st");
  var PMF = "select (select count(*) " + PMW + ") pm_done, (select count(*) " + PMW +
            " and exists (select 1 from workorder f where f.origrecordclass = 'WORKORDER' and f.origrecordid = w.wonum and f.siteid = w.siteid)) pm_followup" + DUAL;
  var SCH = "select count(*) sch_n, " + cntIf("st.maxvalue in ('COMP','CLOSE') and w.actfinish < " + plus1("w.schedfinish")) + " sch_ok, " +
            "sum(" + nz("w.estlabhrs") + ") sch_est, " +
            sumIf("st.maxvalue in ('COMP','CLOSE') and w.actfinish < " + plus1("w.schedfinish"), nz("w.estlabhrs")) + " sch_est_ok " +
            "from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and st.maxvalue <> 'CAN' and w.schedfinish >= " + S +
            " and w.schedfinish < " + E;
  var FW = "from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and w.assetnum is not null and " + isFail("w") + " and " + done("w", "st");
  var F = "select count(*) fail_n, count(distinct w.assetnum) fail_assets, " +
          sumIf(REPAIR, hrs("w.actstart", "w.actfinish")) + " rep_hrs, " + cntIf(REPAIR) + " rep_n, " +
          cntIf("w.failurecode is not null") + " fail_coded " + FW;
  // rework: a failure that started within 30 days of the previous failure on the same asset being completed
  var LAGF = "select w.wonum, w.siteid, w.reportdate, w.actfinish, st.maxvalue mv, " +
             "lag(w.actfinish) over (partition by w.assetnum, w.siteid order by w.reportdate, w.wonum) prev_fin " +
             "from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and w.assetnum is not null and " + isFail("w") +
             " and w.reportdate < " + E;
  var R = "select count(*) fail_repeat from (" + LAGF + ") r where r.mv in ('COMP','CLOSE') and r.actfinish >= " + S +
          " and r.actfinish < " + E + " and r.prev_fin is not null and r.reportdate >= r.prev_fin and " +
          dys("r.prev_fin", "r.reportdate") + " <= 30";
  var DT = "select count(*) down_n, sum(" + nz("x.downtime") + ") down_hrs, " +
           "sum(case when dw.wonum is not null and " + isPrev("dw") + " then " + nz("x.downtime") + " else 0 end) down_sched " +
           "from assetstatus x left join workorder dw on dw.wonum = x.wonum and dw.siteid = x.siteid " +
           "where x.isrunning = 1 and x.changedate >= " + S + " and x.changedate < " + E + siteF("x");
  var O = "select count(*) open_n, " + cntIf(dys("w.reportdate", E) + " > 90") + " open_90, " +
          sumIf("st.maxvalue " + BACKLOG, nz("w.estlabhrs")) + " backlog_hrs, " +
          sumIf("st.maxvalue " + READY, nz("w.estlabhrs")) + " ready_hrs, " +
          cntIf("st.maxvalue " + BACKLOG) + " backlog_n, " + cntIf("st.maxvalue " + BACKLOG + " and w.estlabhrs > 0") + " backlog_est_n " +
          "from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and st.maxvalue " + OPEN + " and w.reportdate < " + E;
  var OT = "select sum(" + nz("t.regularhrs") + ") reg_hrs, sum(" + nz("t.premiumpayhours") + ") ot_hrs from labtrans t " +
           "where t.startdate >= " + S + " and t.startdate < " + E + siteF("t");
  var BAL = "select b.itemnum, b.location, b.siteid, b.itemsetid, sum(b.curbal * coalesce(c.avgcost, c.stdcost, c.lastcost, 0)) val, sum(b.curbal) cb " +
            "from invbalances b left join invcost c on c.itemnum = b.itemnum and c.location = b.location and c.siteid = b.siteid " +
            "and c.itemsetid = b.itemsetid and coalesce(c.conditioncode, '~') = coalesce(b.conditioncode, '~') " +
            "group by b.itemnum, b.location, b.siteid, b.itemsetid";
  var INV = "select count(*) inv_items, sum(" + nz("v.val") + ") inv_value, " +
            sumIf("i.lastissuedate is null or i.lastissuedate < " + E365, nz("v.val")) + " inactive_value, " +
            cntIf("i.reorder = 1") + " reorder_items, " + cntIf("i.reorder = 1 and " + nz("v.cb") + " <= 0") + " stockout_items, " +
            cntIf(nz("i.consignment") + " = 1") + " consign_items " +
            "from inventory i left join (" + BAL + ") v on v.itemnum = i.itemnum and v.location = i.location and v.siteid = i.siteid " +
            "and v.itemsetid = i.itemsetid where 1 = 1" + siteF("i");
  var ISS = "select sum(" + nz("m.linecost") + ") issue_cost from matusetrans m where m.issuetype in ('ISSUE','RETURN') " +
            "and m.storeloc is not null and m.transdate >= " + S + " and m.transdate < " + E + siteF("m");
  var CNT = "select (select count(*) from invbalances b where b.physcntdate >= " + S + " and b.physcntdate < " + E + siteF("b") + ") counted, " +
            "(select count(*) from invtrans t where t.transtype = 'PCOUNTADJ' and t.transdate >= " + S + " and t.transdate < " + E + siteF("t") + ") adjusted" + DUAL;
  var parts = [A, L, D, PM, PMO, PMF, SCH, F, R, DT, O, OT, INV, ISS, CNT];
  var sql = "select * from ";
  for (var i = 0; i < parts.length; i++) sql += (i ? " cross join " : "") + "(" + parts[i] + ") q" + i;
  o.kpiSql = mark(sql);

  // ---- scorecard rows: one per KPI; the values come from the kpiSql row (see kpiDef in the report)
  var rows = [];
  for (var k = 1; k <= 40; k++) rows.push("select " + k + " sk" + DUAL);
  o.scoreSql = mark("select sk from (" + rows.join(" union all ") + ") z order by sk");

  // ---- hours and work orders per month and category (completed work)
  var M = ym("w.actfinish");
  o.monthlySql = mark("select " + M + " bkt, " +
    sumIf(C + " = 'P'", nz("w.actlabhrs")) + " hrs_p, " + sumIf(C + " = 'D'", nz("w.actlabhrs")) + " hrs_d, " +
    sumIf(C + " = 'C'", nz("w.actlabhrs")) + " hrs_c, " + sumIf(C + " = 'E'", nz("w.actlabhrs")) + " hrs_e, " +
    sumIf(C + " = 'O'", nz("w.actlabhrs")) + " hrs_o, " + cntIf("w.istask = 0") + " wos " +
    "from " + wo("w", "st") + " where " + BASE + " and " + done("w", "st") + " group by " + M + " order by 1");

  // ---- by work category
  o.categorySql = mark("select " + C + " cat, " + cntIf("w.istask = 0") + " wos, sum(" + nz("w.actlabhrs") + ") hrs, " +
    "sum(" + nz("w.actlabcost") + ") c_lab, sum(" + nz("w.actmatcost") + ") c_mat, sum(" + nz("w.actservcost") + ") c_serv, " +
    "sum(" + nz("w.acttoolcost") + ") c_tool, sum(" + cost("w") + ") c_total, " +
    sumIf(PLANNED, nz("w.actlabhrs")) + " hrs_planned " +
    "from " + wo("w", "st") + " where " + BASE + " and " + done("w", "st") + " group by " + C + " order by 1");

  // ---- by work type
  o.worktypeSql = mark(limit("select coalesce(w.worktype, '(none)') wtype, max(" + C + ") cat, " + cntIf("w.istask = 0") + " wos, " +
    "sum(" + nz("w.actlabhrs") + ") hrs, sum(" + cost("w") + ") c_total, " +
    cntIf("w.istask = 0 and " + PLANNED) + " planned_n, " +
    sumIf("w.istask = 0 and w.reportdate is not null and w.reportdate <= w.actfinish", dys("w.reportdate", "w.actfinish")) + " cycle_days, " +
    cntIf("w.istask = 0 and w.reportdate is not null and w.reportdate <= w.actfinish") + " cycle_n " +
    "from " + wo("w", "st") + " where " + BASE + " and " + done("w", "st") + " group by coalesce(w.worktype, '(none)') order by 4 desc", 20));

  // ---- by site: one scan with conditional sums
  var DN = done("w", "st"), DUE = due("w");
  o.siteSql = mark("select w.siteid site, " + cntIf("w.istask = 0 and " + DN) + " wos, " + sumIf(DN, nz("w.actlabhrs")) + " hrs, " +
    sumIf(DN, cost("w")) + " c_total, " +
    sumIf(DN + " and " + C + " in ('P','D')", nz("w.actlabhrs")) + " hrs_prev, " + sumIf(DN + " and " + C + " = 'E'", nz("w.actlabhrs")) + " hrs_emer, " +
    cntIf("w.istask = 0 and st.maxvalue <> 'CAN' and " + isPrev("w") + " and " + DUE + " >= " + S + " and " + DUE + " < " + E) + " pm_due, " +
    cntIf("w.istask = 0 and st.maxvalue in ('COMP','CLOSE') and " + isPrev("w") + " and " + DUE + " >= " + S + " and " + DUE + " < " + E +
          " and w.actfinish < " + plus1(DUE)) + " pm_ok, " +
    cntIf("w.istask = 0 and st.maxvalue <> 'CAN' and w.schedfinish >= " + S + " and w.schedfinish < " + E) + " sch_n, " +
    cntIf("w.istask = 0 and st.maxvalue in ('COMP','CLOSE') and w.schedfinish >= " + S + " and w.schedfinish < " + E +
          " and w.actfinish < " + plus1("w.schedfinish")) + " sch_ok, " +
    cntIf("w.istask = 0 and w.assetnum is not null and " + isFail("w") + " and " + DN) + " fail_n, " +
    cntIf("w.istask = 0 and st.maxvalue " + OPEN + " and w.reportdate < " + E) + " open_n, " +
    sumIf("w.istask = 0 and st.maxvalue " + BACKLOG + " and w.reportdate < " + E, nz("w.estlabhrs")) + " backlog_hrs " +
    "from " + wo("w", "st") + " where " + BASE + " group by w.siteid order by 3 desc");

  // ---- bad actors: assets with the most failures
  o.badActorsSql = mark(limit("select w.assetnum asset, w.siteid site, max(a.description) descr, max(a.priority) prio, " +
    "count(*) fails, " + sumIf(REPAIR, hrs("w.actstart", "w.actfinish")) + " rep_hrs, " + cntIf(REPAIR) + " rep_n, " +
    "sum(" + cost("w") + ") c_total, max(w.actfinish) last_fail, max(w.failurecode) fclass " +
    FW.replace("from " + wo("w", "st"), "from " + wo("w", "st") + " left join asset a on a.assetnum = w.assetnum and a.siteid = w.siteid") +
    " group by w.assetnum, w.siteid order by 5 desc, 8 desc", 12));

  // ---- failure classes behind the failures
  o.failClassSql = mark(limit("select coalesce(w.failurecode, '(no failure class)') fclass, count(*) fails, count(distinct w.assetnum) assets, " +
    "sum(" + cost("w") + ") c_total " + FW + " group by coalesce(w.failurecode, '(no failure class)') order by 2 desc", 8));

  // ---- open work by age
  var AGE = dys("w.reportdate", E);
  var BK = "(case when " + AGE + " <= 30 then 1 when " + AGE + " <= 90 then 2 when " + AGE + " <= 180 then 3 when " + AGE + " <= 365 then 4 else 5 end)";
  o.agingSql = mark("select " + BK + " bk, count(*) n, " + cntIf(C + " in ('P','D')") + " n_prev, " + cntIf(C + " in ('C','E')") + " n_corr, " +
    "sum(" + nz("w.estlabhrs") + ") est_hrs from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and st.maxvalue " + OPEN +
    " and w.reportdate < " + E + " group by " + BK + " order by 1");

  // ---- open work by status
  o.backlogSql = mark("select st.maxvalue status, count(*) n, " + cntIf("w.estlabhrs > 0") + " n_est, sum(" + nz("w.estlabhrs") + ") est_hrs, " +
    "min(w.reportdate) oldest from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and st.maxvalue " + OPEN +
    " and w.reportdate < " + E + " group by st.maxvalue order by 2 desc");

  // ---- overdue preventive work, most overdue first
  o.overdueSql = mark(limit("select w.wonum wonum, w.siteid site, w.description descr, w.assetnum asset, w.pmnum pmnum, w.status status, " +
    DUE + " due, " + dys(DUE, E) + " days_over from " + wo("w", "st") + " where " + BASE + " and w.istask = 0 and st.maxvalue " + OPEN +
    " and st.maxvalue <> 'WAPPR' and " + isPrev("w") + " and " + DUE + " < " + E + " and w.reportdate < " + E + " order by 7", 12));

  // ---- storerooms
  var ISSL = "select m.storeloc, m.siteid, sum(" + nz("m.linecost") + ") issue_cost from matusetrans m where m.issuetype in ('ISSUE','RETURN') " +
             "and m.storeloc is not null and m.transdate >= " + S + " and m.transdate < " + E + " group by m.storeloc, m.siteid";
  o.storesSql = mark(limit("select i.location store, i.siteid site, count(*) items, sum(" + nz("v.val") + ") inv_value, " +
    sumIf("i.lastissuedate is null or i.lastissuedate < " + E365, nz("v.val")) + " inactive_value, " +
    cntIf("i.reorder = 1") + " reorder_items, " + cntIf("i.reorder = 1 and " + nz("v.cb") + " <= 0") + " stockout_items, " +
    "max(" + nz("u.issue_cost") + ") issue_cost " +
    "from inventory i left join (" + BAL + ") v on v.itemnum = i.itemnum and v.location = i.location and v.siteid = i.siteid " +
    "and v.itemsetid = i.itemsetid left join (" + ISSL + ") u on u.storeloc = i.location and u.siteid = i.siteid " +
    "where 1 = 1" + siteF("i") + " group by i.location, i.siteid order by 4 desc", 20));

  return o;
}

if (typeof module !== "undefined") module.exports = { smrpSql: smrpSql, smrpPeriodSql: smrpPeriodSql, smrpCodes: smrpCodes };


dbEngine = null;
smrpErrs = {};
P = null;
K = {};
KCOLS = ["rav", "nassets", "ncrit", "labor_n", "wo_done", "hrs_total", "cost_total", "cost_lab", "cost_mat", "cost_serv", "cost_tool", "hrs_p", "hrs_d", "hrs_c", "hrs_e", "hrs_o", "cost_p", "cost_d", "cost_c", "cost_e", "cost_o", "hrs_planned", "act_hrs_est", "est_hrs", "act_cost_est", "est_cost", "cost_out", "hrs_int", "hrs_out", "cycle_days", "cycle_n", "pm_due", "pm_ok", "pm_overdue", "pm_overdue_hrs", "pm_done", "pm_followup", "sch_n", "sch_ok", "sch_est", "sch_est_ok", "fail_n", "fail_assets", "rep_hrs", "rep_n", "fail_coded", "fail_repeat", "down_hrs", "down_sched", "open_n", "open_90", "backlog_hrs", "ready_hrs", "backlog_n", "backlog_est_n", "down_n", "reg_hrs", "ot_hrs", "inv_items", "inv_value", "inactive_value", "reorder_items", "stockout_items", "consign_items", "issue_cost", "counted", "adjusted"];
N_KPI = 40;

function dbKind(ds) {
  var n = String(ds.getDatabaseProductName()).toLowerCase();
  if (n.indexOf("oracle") >= 0) return "oracle";
  if (n.indexOf("microsoft") >= 0 || n.indexOf("sql server") >= 0) return "sqlserver";
  return "db2";
}
function engineName() {
  return dbEngine == "oracle" ? "Oracle" : dbEngine == "db2" ? "Db2" : dbEngine == "sqlserver" ? "SQL Server" : "";
}
function maxVersion(v) {
  var m = /^V(\d)(\d)(\d)(\d)?-(\d+)/.exec(String(v));
  if (!m) return v == null ? "version unknown" : String(v);
  return m[1] + "." + m[2] + "." + m[3] + (m[4] ? "." + m[4] : "");
}
function pv(name) {
  var v = params[name].value;
  return v == null ? "" : String(v);
}
function siteName() { var s = smrpSite(pv("Site")); return s ? "site " + s : "all sites"; }

// ---- the period: month index = year * 12 + month - 1
function smrpPeriod(counts) {
  var MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
  var months = parseInt(pv("Months"), 10);
  if (isNaN(months) || months < 1) months = 12;
  if (months > 60) months = 60;
  var now = new Date(), last = now.getFullYear() * 12 + now.getMonth() - 1, end = last, auto = false;
  var em = /^(\d{4})-(\d{1,2})$/.exec(pv("End_Month").replace(/\s/g, ""));
  if (em) {
    end = parseInt(em[1], 10) * 12 + parseInt(em[2], 10) - 1;
  } else {
    var max = 0, k;
    for (k in counts) if (counts[k] > max) max = counts[k];
    if (max > 0) {
      var recent = 0;
      for (k in counts) if (Number(k) > last - 12 && Number(k) <= last) recent += counts[k];
      if (recent < max) {   // less than one busy month of work in the last 12 months: a test or archive copy
        var best = -1;
        for (k in counts) if (Number(k) <= last && counts[k] >= max * 0.1 && Number(k) > best) best = Number(k);
        if (best >= 0) { end = best; auto = true; }
      }
    }
  }
  function ymd(i) { var y = Math.floor(i / 12), m = i % 12 + 1; return y + "-" + (m < 10 ? "0" : "") + m + "-01"; }
  function nice(i) { return MON[i % 12] + " " + Math.floor(i / 12); }
  var s = end - months + 1;
  var d0 = new Date(Math.floor(s / 12), s % 12, 1), d1 = new Date(Math.floor((end + 1) / 12), (end + 1) % 12, 1);
  return { start: ymd(s), end: ymd(end + 1), e365: ymd(end + 1 - 12), months: months, auto: auto,
           days: Math.round((d1.getTime() - d0.getTime()) / 86400000),
           label: months + " months: " + nice(s) + " to " + nice(end) };
}
function smrpP() {
  if (P == null) P = smrpPeriod({});
  return { site: pv("Site"), start: P.start, end: P.end, e365: P.e365, nkpi: N_KPI,
           prev: pv("Preventive_Types"), pdm: pv("Predictive_Types"), corr: pv("Corrective_Types"), emer: pv("Emergency_Types") };
}
function smrpEmpty(ds, txt) { return smrpErrs[ds] ? "Could not be read: " + smrpErrs[ds] : txt; }

// ---- formatting
function num(x) { return x == null || isNaN(x) ? null : Number(x); }
function ratio(a, b) { a = num(a); b = num(b); return a == null || b == null || b == 0 ? null : a / b; }
function pctText(a, b) { var r = ratio(a, b); return r == null ? "" : Formatter.format(r * 100, "#,##0.0") + "%"; }
function catName(c) {
  return { P: "Preventive", D: "Predictive", C: "Corrective", E: "Emergency", O: "Other" }[String(c)] || String(c);
}
function ageName(b) {
  return { 1: "Up to 30 days", 2: "31 to 90 days", 3: "91 to 180 days", 4: "181 to 365 days", 5: "Over a year" }[Number(b)] || "";
}
function fmtMoney(v) {
  if (Math.abs(v) >= 1e9) return Formatter.format(v / 1e9, "#,##0.0") + " bn";
  if (Math.abs(v) >= 1e6) return Formatter.format(v / 1e6, "#,##0.0") + " M";
  return Formatter.format(v, "#,##0");
}
function fmtKpi(v, u) {
  if (v == null) return "";
  switch (u) {
    case "pct": return Formatter.format(v, "#,##0.0") + "%";
    case "money": return fmtMoney(v);
    case "days": return Formatter.format(v, "#,##0.0") + " days";
    case "hours": return Formatter.format(v, "#,##0.0") + " h";
    case "weeks": return Formatter.format(v, "#,##0.0") + " weeks";
    case "turns": return Formatter.format(v, "#,##0.00") + " / year";
    default: return Formatter.format(v, "#,##0");
  }
}

// ---- the KPIs: pillar, name, value, unit, common reference, test, how it is measured
function kpiDef(sk) {
  sk = Number(sk);
  if (typeof KD == "undefined" || KD == null) KD = kpiDefs();
  return KD[sk] ? KD[sk] : null;
}
function kpiDefs() {
  var f = 12 / (P ? P.months : 12), H = (P ? P.days : 365) * 24;
  var B = "Business & management", PR = "Process reliability", ER = "Equipment reliability", OL = "Organization & leadership",
      WM = "Work management";
  function pc(a, b) { var r = ratio(a, b); return r == null ? null : r * 100; }
  function d(pillar, name, val, unit, ref, ok, how) { return { pillar: pillar, name: name, val: val, unit: unit, ref: ref, ok: ok, how: how }; }
  function atMost(x) { return function (v) { return v <= x; }; }
  function atLeast(x) { return function (v) { return v >= x; }; }
  function between(a, b) { return function (v) { return v >= a && v <= b; }; }
  var weekly = ratio(K.hrs_total, (P ? P.days : 365) / 7);
  var opHours = num(K.nassets) == null ? null : K.nassets * H - (num(K.down_hrs) || 0);
  var L = {};
  L[1] = d(B, "Replacement asset value (RAV)", K.rav > 0 ? K.rav : null, "money", "", null,
           "Replacement cost of operating assets (ASSET.REPLACECOST), " + fmtKpi(K.nassets, "n") + " operating assets.");
  L[2] = d(B, "Total maintenance cost, per year", K.cost_total == null ? null : K.cost_total * f, "money", "", null,
           "Actual labour, material, service and tool cost of completed work orders, scaled to 12 months.");
  L[3] = d(B, "Maintenance cost as a percent of RAV", K.rav > 0 ? pc(K.cost_total * f, K.rav) : null, "pct", "2% to 3%", atMost(3),
           "Annual maintenance cost divided by RAV.");
  L[4] = d(B, "RAV per craft worker", K.rav > 0 ? ratio(K.rav, K.labor_n) : null, "money", "", null,
           "RAV divided by active labour records (" + fmtKpi(K.labor_n, "n") + ").");
  L[5] = d(B, "Stores inventory value as a percent of RAV", K.rav > 0 ? pc(K.inv_value, K.rav) : null, "pct", "", null,
           "Storeroom value at average cost divided by RAV.");
  L[6] = d(B, "Maintenance unit cost (cost per unit of output)", null, "", "", "outside", "Needs production volumes from the plant systems.");
  L[7] = d(PR, "Overall equipment effectiveness (OEE)", null, "", "", "outside",
           "Availability x performance x quality: needs production rates and quality data from the plant systems.");
  L[8] = d(PR, "Total effective equipment performance (TEEP)", null, "", "", "outside", "OEE over calendar time: needs production data.");
  L[9] = d(ER, "Assets covered by criticality ranking", pc(K.ncrit, K.nassets), "pct", "100% of critical", atLeast(95),
           "Operating assets with a priority (criticality) set on the asset record.");
  L[10] = d(ER, "Total downtime", K.down_n > 0 ? num(K.down_hrs) : null, "hours", "", null, "Downtime hours reported on asset status changes (ASSETSTATUS) in the period.");
  L[11] = d(ER, "Unscheduled downtime, percent of downtime", K.down_hrs > 0 ? 100 - pc(K.down_sched, K.down_hrs) : null, "pct", "", null,
            "Downtime not reported against preventive work, as a share of all downtime.");
  L[12] = d(ER, "Mean time between failures (MTBF)", K.fail_n > 0 && opHours != null ? opHours / K.fail_n / 24 : null, "days", "", null,
            fmtKpi(K.fail_n, "n") + " failures on " + fmtKpi(K.fail_assets, "n") + " assets; operating time of all operating assets less downtime, per failure.");
  L[13] = d(ER, "Mean time to repair (MTTR)", ratio(K.rep_hrs, K.rep_n), "hours", "", null,
            "Average actual start-to-finish time of failure work orders (" + fmtKpi(K.rep_n, "n") + " with both times, under 30 days).");
  L[14] = d(ER, "Failures closed with a failure class", pc(K.fail_coded, K.fail_n), "pct", "100%", atLeast(90),
            "Share of failures with a failure class: the data every reliability analysis starts from.");
  L[15] = d(OL, "Rework: repeat failures within 30 days", pc(K.fail_repeat, K.fail_n), "pct", "", null,
            "Failures that started within 30 days of the previous failure on the same asset being completed.");
  L[16] = d(OL, "Contractor cost, percent of maintenance cost", pc(K.cost_out, K.cost_total), "pct", "", null,
            "Outside labour and service cost of completed work orders.");
  L[17] = d(OL, "Maintenance overtime, percent of hours", K.reg_hrs + K.ot_hrs > 0 ? pc(K.ot_hrs, K.reg_hrs + K.ot_hrs) : null, "pct",
            "5% to 10%", atMost(10), "Premium-pay hours on labour transactions (LABTRANS) in the period.");
  L[18] = d(WM, "Preventive maintenance hours, percent of hours", pc(K.hrs_p, K.hrs_total), "pct", "", null,
            "Hours on preventive work orders (PM-generated or a preventive work type).");
  L[19] = d(WM, "Predictive / condition-based maintenance hours, percent", pc(K.hrs_d, K.hrs_total), "pct", "", null,
            "Hours on predictive and condition-based work types.");
  L[20] = d(WM, "Corrective maintenance hours, percent of hours", pc(K.hrs_c + K.hrs_e, K.hrs_total), "pct", "", null,
            "Hours on corrective and emergency work.");
  L[21] = d(WM, "Reactive (emergency) work, percent of hours", pc(K.hrs_e, K.hrs_total), "pct", "10% or less", atMost(10),
            "Hours on emergency work types: work that broke into the schedule.");
  L[22] = d(WM, "Preventive and predictive maintenance cost, percent", pc(K.cost_p + K.cost_d, K.cost_total), "pct", "", null,
            "Cost of preventive and predictive work as a share of maintenance cost.");
  L[23] = d(WM, "Corrective maintenance cost, percent", pc(K.cost_c + K.cost_e, K.cost_total), "pct", "", null,
            "Cost of corrective and emergency work as a share of maintenance cost.");
  L[24] = d(WM, "Planned work, percent of hours", pc(K.hrs_planned, K.hrs_total), "pct", "85% or more", atLeast(85),
            "Hours on work orders that had a labour estimate or a job plan.");
  L[25] = d(WM, "Actual hours to planning estimate", pc(K.act_hrs_est, K.est_hrs), "pct", "90% to 110%", between(90, 110),
            "Actual labour hours divided by estimated hours, on completed work orders with an estimate.");
  L[26] = d(WM, "Actual cost to planning estimate", pc(K.act_cost_est, K.est_cost), "pct", "90% to 110%", between(90, 110),
            "Actual cost divided by estimated cost, on completed work orders with an estimate.");
  L[27] = d(WM, "Schedule compliance, work orders", pc(K.sch_ok, K.sch_n), "pct", "90% or more", atLeast(90),
            fmtKpi(K.sch_n, "n") + " work orders scheduled to finish in the period; share finished by the scheduled day.");
  L[28] = d(WM, "Schedule compliance, hours", pc(K.sch_est_ok, K.sch_est), "pct", "90% or more", atLeast(90),
            "Estimated hours of scheduled work finished on time, divided by estimated hours scheduled.");
  L[29] = d(WM, "PM & PdM compliance", pc(K.pm_ok, K.pm_due), "pct", "90% or more", atLeast(90),
            fmtKpi(K.pm_due, "n") + " preventive work orders due in the period; share completed by the due day.");
  L[30] = d(WM, "PM & PdM work orders overdue", num(K.pm_overdue), "n", "0", atMost(0),
            "Approved preventive work orders still open past their due date at the end of the period.");
  L[31] = d(WM, "PM & PdM yield", pc(K.pm_followup, K.pm_done), "pct", "", null,
            "Completed preventive work orders that raised follow-up work (corrective work found before it failed).");
  L[32] = d(WM, "Work order cycle time", ratio(K.cycle_days, K.cycle_n), "days", "", null,
            "Average days from reported to actual finish, completed work orders.");
  L[33] = d(WM, "Open work orders older than 90 days", pc(K.open_90, K.open_n), "pct", "", null,
            fmtKpi(K.open_n, "n") + " open work orders at the end of the period.");
  L[34] = d(WM, "Planned backlog", ratio(K.backlog_hrs, weekly), "weeks", "4 to 6 weeks", between(4, 6),
            "Estimated hours of approved, scheduled, in-progress and waiting-for-material work, divided by hours worked per week (" +
            fmtKpi(K.backlog_est_n, "n") + " of " + fmtKpi(K.backlog_n, "n") + " have an estimate).");
  L[35] = d(WM, "Ready backlog", ratio(K.ready_hrs, weekly), "weeks", "2 to 4 weeks", between(2, 4),
            "Estimated hours of approved and waiting-to-schedule work, divided by hours worked per week.");
  L[36] = d(WM, "Stores inventory turns", K.inv_value > 0 ? ratio((num(K.issue_cost) || 0) * f, K.inv_value) : null, "turns", "", null,
            "Annual issue cost from storerooms divided by current inventory value.");
  L[37] = d(WM, "Stock-outs (reorder items with no stock)", pc(K.stockout_items, K.reorder_items), "pct", "", null,
            fmtKpi(K.reorder_items, "n") + " reorder-managed items; share with no balance.");
  L[38] = d(WM, "Inactive stock, percent of inventory value", pc(K.inactive_value, K.inv_value), "pct", "", null,
            "Value of items not issued in the last 12 months.");
  L[39] = d(WM, "Storeroom records accuracy", K.counted > 0 ? 100 - pc(Math.min(K.adjusted, K.counted), K.counted) : null, "pct",
            "95% or more", atLeast(95), "Counted balances in the period that needed no count adjustment.");
  L[40] = d(WM, "Vendor-managed (consignment) items", pc(K.consign_items, K.inv_items), "pct", "", null,
            "Inventory items flagged as consignment.");
  return L;
}
function kpiText(sk) {
  var k = kpiDef(sk);
  if (k == null) return "";
  if (k.ok == "outside") return "outside Maximo";
  if (smrpErrs["dsKpi"]) return "not read";
  return k.val == null ? "no data" : fmtKpi(k.val, k.unit);
}
function kpiStatus(sk) {
  var k = kpiDef(sk);
  if (k == null) return "";
  if (k.ok == "outside") return "Outside Maximo";
  if (k.val == null) return "No data";
  if (k.ok == null) return "Info";
  return k.ok(k.val) ? "On target" : "Watch";
}
function kpiTile(sk) {
  var k = kpiDef(sk);
  if (k == null) return "";
  var s = kpiStatus(sk);
  return (k.ref ? "reference " + k.ref + "  ·  " : "") + (s == "On target" ? "on target" : s == "Watch" ? "watch" : s.toLowerCase());
}

KD = null;
]]></method>
