                <structure><property name="name">mtbf</property>
                    <expression name="expression" type="javascript"><![CDATA[row["fails"] > 0 ? Formatter.format(P.days / row["fails"], "#,##0.0") : ""]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">mttr</property>
                    <expression name="expression" type="javascript"><![CDATA[row["rep_n"] > 0 ? Formatter.format(row["rep_hrs"] / row["rep_n"], "#,##0.0") : "not recorded"]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">lastf</property>
                    <expression name="expression" type="javascript"><![CDATA[row["last_fail"] == null ? "" : String(row["last_fail"]).substring(0, 10)]]></expression>
