            <method name="open"><![CDATA[rows_dsKpi = 0;
dsKpiDS = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
dsKpiDS.open();
if (dbEngine == null) dbEngine = dbKind(dsKpiDS);
var sqlText = smrpSql(dbEngine, smrpP()).kpiSql;
if (scriptLogger.isDebugEnabled()) scriptLogger.debug("dsKpi sql = " + sqlText);
dsKpiDS.setQuery(sqlText);
run_dsKpi = true;]]></method>
            <method name="fetch"><![CDATA[if (!run_dsKpi) return (false);
try {
  if (!dsKpiDS.fetch()) return (false);
} catch (e) {
  smrpErrs["dsKpi"] = String(e);
  scriptLogger.error("SMRP KPI pack: dsKpi failed: " + e);
  run_dsKpi = false;
  return (false);
}
