        </table><data id="600"><list-property name="visibility"><structure><property name="format">all</property><expression name="valueExpr" type="javascript"><![CDATA[rows_dsOverdue > 0]]></expression></structure></list-property><property name="fontSize">8.5pt</property><property name="color">#6f6f6f</property><property name="paddingTop">10pt</property><property name="paddingBottom">10pt</property><property name="paddingLeft">8pt</property><property name="borderBottomColor">#e0e0e0</property><property name="borderBottomStyle">solid</property><property name="borderBottomWidth">1px</property><list-property name="boundDataColumns"><structure><property name="name">v</property><expression name="expression" type="javascript"><![CDATA[smrpEmpty("dsOverdue", "No preventive work is overdue.")]]></expression><property name="dataType">string</property></structure></list-property><property name="resultSetColumn">v</property></data><grid id="606"><property name="pageBreakBefore">always</property><property name="pageBreakInside">avoid</property><property name="marginTop">18pt</property><property name="width">10.1in</property><column id="607"/><row id="608"><cell id="609"><label id="603"><property name="fontSize">7.5pt</property><property name="color">#0f62fe</property><property name="fontWeight">bold</property><property name="letterSpacing">0.32pt</property><text-property name="text">4  ·  WORK MANAGEMENT: STORES</text-property></label><label id="604"><property name="fontSize">14pt</property><property name="color">#161616</property><property name="marginTop">2pt</property><property name="marginBottom">2pt</property><text-property name="text">Storerooms</text-property></label><label id="605"><property name="fontSize">8.5pt</property><property name="color">#525252</property><property name="marginBottom">8pt</property><text-property name="text">Inventory value (current balance at average cost), stock not issued in the last 12 months, items at or below zero that Maximo reorders, and issues in the period. Turns are annual issue cost divided by the current inventory value.</text-property></label></cell></row></grid>
        <table id="657">
            <property name="width">10.10in</property>
            <property name="dataSet">dsStores</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">store</property>
                    <expression name="expression" type="javascript">dataSetRow["store"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">site</property>
                    <expression name="expression" type="javascript">dataSetRow["site"]</expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">items</property>
                    <expression name="expression" type="javascript">dataSetRow["items"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">inv_value</property>
                    <expression name="expression" type="javascript">dataSetRow["inv_value"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">inactive_value</property>
                    <expression name="expression" type="javascript">dataSetRow["inactive_value"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">reorder_items</property>
                    <expression name="expression" type="javascript">dataSetRow["reorder_items"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">stockout_items</property>
                    <expression name="expression" type="javascript">dataSetRow["stockout_items"]</expression>
                    <property name="dataType">integer</property></structure>
                <structure><property name="name">issue_cost</property>
                    <expression name="expression" type="javascript">dataSetRow["issue_cost"]</expression>
                    <property name="dataType">float</property></structure>
                <structure><property name="name">inact</property>
                    <expression name="expression" type="javascript"><![CDATA[pctText(row["inactive_value"], row["inv_value"])]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">turns</property>
                    <expression name="expression" type="javascript"><![CDATA[row["inv_value"] > 0 ? Formatter.format(row["issue_cost"] * (12 / P.months) / row["inv_value"], "#,##0.00") : ""]]></expression>
                    <property name="dataType">string</property></structure>
                <structure><property name="name">so</property>
                    <expression name="expression" type="javascript"><![CDATA[pctText(row["stockout_items"], row["reorder_items"])]]></expression>
                    <property name="dataType">string</property></structure>
            </list-property>
            <property name="pageBreakInterval">0</property>
            <column id="628"><property name="width">1.4in</property></column><column id="629"><property name="width">1.1in</property></column><column id="630"><property name="width">0.8in</property></column><column id="631"><property name="width">1.3in</property></column><column id="632"><property name="width">1.1in</property></column><column id="633"><property name="width">1.1in</property></column><column id="634"><property name="width">1.0in</property></column><column id="635"><property name="width">1.2in</property></column><column id="636"><property name="width">1.1in</property></column>
