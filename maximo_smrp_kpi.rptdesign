        <script-data-set name="dsPeriod" id="728">
            <list-property name="resultSetHints">
                <structure><property name="position">1</property><property name="name">period</property><property name="dataType">string</property></structure>
                <structure><property name="position">2</property><property name="name">months</property><property name="dataType">integer</property></structure>
                <structure><property name="position">3</property><property name="name">auto</property><property name="dataType">integer</property></structure>
                <structure><property name="position">4</property><property name="name">upg</property><property name="dataType">string</property></structure>
            </list-property>
            <structure name="cachedMetaData"><list-property name="resultSet">
                <structure><property name="position">1</property><property name="name">period</property><property name="dataType">string</property></structure>
                <structure><property name="position">2</property><property name="name">months</property><property name="dataType">integer</property></structure>
                <structure><property name="position">3</property><property name="name">auto</property><property name="dataType">integer</property></structure>
                <structure><property name="position">4</property><property name="name">upg</property><property name="dataType">string</property></structure>
            </list-property></structure>
            <property name="dataSource">maximoDataSource</property>
            <method name="open"><![CDATA[rows_dsPeriod = 0; periodDone = false;
dsPeriodDS = MXReportDataSetProvider.create(this.getDataSource().getName(), this.getName());
dsPeriodDS.open();
dbEngine = dbKind(dsPeriodDS);
dsPeriodDS.setQuery(smrpPeriodSql(dbEngine, params["Site"].value));]]></method>
            <method name="fetch"><![CDATA[if (periodDone) return (false);
periodDone = true;
var counts = {}, upg = null;
try {
  while (dsPeriodDS.fetch()) {
    counts[dsPeriodDS.getInteger("yr") * 12 + dsPeriodDS.getInteger("mo") - 1] = dsPeriodDS.getInteger("n");
    upg = dsPeriodDS.getString("upg");
  }
} catch (e) {
  smrpErrs["dsPeriod"] = String(e);
  scriptLogger.error("SMRP KPI pack: dsPeriod failed: " + e);
}
P = smrpPeriod(counts);
row["period"] = P.label; row["months"] = P.months; row["auto"] = P.auto ? 1 : 0; row["upg"] = upg;
rows_dsPeriod++;
return (true);]]></method>
            <method name="close"><![CDATA[dsPeriodDS.close();]]></method>
        </script-data-set>
